# Secrets for the reference containers (tools/interop/compose.yaml). Docker
# Compose reads tools/interop/.env automatically; .gitignore keeps it out of
# the repo, because these hosts answer on the public internet (ref-pds.,
# ref-pds2., ref-relay., ref-plc., ref-appview.aerox.sola.town).
#
#   cp tools/interop/.env.example tools/interop/.env
#   # then fill each line: openssl rand -hex 16 (secrets), openssl rand -hex 32 (keys)
#
# Changing a PDS rotation key orphans the DIDs that already name it: the
# container can no longer sign PLC operations for accounts created before.
REF_PLC_ADMIN_SECRET=
REF_RELAY_ADMIN_PASSWORD=
REF_PDS_JWT_SECRET=
REF_PDS_ADMIN_PASSWORD=
REF_PDS_ROTATION_KEY_HEX=
REF_PDS2_JWT_SECRET=
REF_PDS2_ADMIN_PASSWORD=
REF_PDS2_ROTATION_KEY_HEX=
REF_APPVIEW_ADMIN_PASSWORD=
