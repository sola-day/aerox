{
  "lexicon": 1,
  "id": "aerox.moderation.queryEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "List moderation events, newest first. Admin only.",
      "parameters": {
        "type": "params",
        "properties": {
          "subject": { "type": "string", "description": "A DID or AT-URI to filter on." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["events"],
          "properties": {
            "cursor": { "type": "string" },
            "events": {
              "type": "array",
              "items": { "type": "ref", "ref": "aerox.moderation.defs#modEventView" }
            }
          }
        }
      }
    }
  }
}
