{
  "lexicon": 1,
  "id": "aerox.feed.listPosts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Top-level posts (no replies) across all accounts, newest first: searchPosts' filters without its replies. Taken-down posts are left out.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "description": "Substring of the post text; empty or absent matches every post."
          },
          "author": {
            "type": "string",
            "format": "at-identifier"
          },
          "tag": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 640,
              "maxGraphemes": 64
            },
            "maxItems": 10,
            "description": "Hashtags, without '#'; all must match."
          },
          "since": {
            "type": "string",
            "description": "sortAt lower bound (inclusive): a datetime or YYYY-MM-DD."
          },
          "until": {
            "type": "string",
            "description": "sortAt upper bound (exclusive): a datetime or YYYY-MM-DD."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string",
            "description": "Numeric offset, as searchPosts."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "posts"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "hitsTotal": {
              "type": "integer"
            },
            "posts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.bsky.feed.defs#postView"
              }
            }
          }
        }
      }
    }
  }
}
