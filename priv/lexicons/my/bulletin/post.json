{
  "lexicon": 1,
  "id": "my.bulletin.post",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "image": {
            "type": "blob",
            "accept": ["image/jpeg", "image/png", "image/webp"],
            "maxSize": 500000
          },
          "imageAlt": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "color": {
            "type": "string",
            "knownValues": ["yellow", "pink", "blue", "green", "lavender"]
          },
          "rotation": {
            "type": "integer",
            "minimum": -25,
            "maximum": 25,
            "description": "Clockwise rotation in tenths of a degree."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
