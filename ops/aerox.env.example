# /etc/aerox/<env>.env — 0600, owned by the aerox service user, loaded by
# systemd (EnvironmentFile=). DEV_PLAN §1.3: never in the repo, never in shell
# history. Copy, fill, `chmod 600`.
PHX_SERVER=true
PHX_HOST=example.com             # the PDS host; other services default to <name>.<PHX_HOST>
PORT=4000
BIND_IP=127.0.0.1                # listen only where the reverse proxy dials; unset binds every interface
SECRET_KEY_BASE=                 # mix phx.gen.secret
TRUSTED_PROXIES=127.0.0.1        # the reverse proxy's peer addresses (DESIGN §18.2)

# One URL per repo (DESIGN §4.6); the PDS database may live elsewhere.
PDS_DATABASE_URL=ecto://aerox_pds:…@db/aerox_pds
PLC_DATABASE_URL=ecto://aerox_plc:…@db/aerox_core
RELAY_DATABASE_URL=ecto://aerox_relay:…@db/aerox_core
APPVIEW_DATABASE_URL=ecto://aerox_appview:…@db/aerox_core
LABELER_DATABASE_URL=ecto://aerox_labeler:…@db/aerox_core
POOL_SIZE=10

# PDS
JWT_SECRET=                      # HS256 key for legacy sessions (openssl rand -hex 32)
OAUTH_KEY_HEX=                   # P-256 issuer key (openssl rand -hex 32)
RECOVERY_DID_KEY=                # did:key of the offline recovery key (DESIGN §14.2)
INVITES_REQUIRED=true
CONTACT_EMAIL=
HANDLE_DOMAINS=.example.com
BLOB_ROOT=/var/lib/aerox/blobs

# Rotation-key signer: never Local in production.
SIGNER=remote                    # remote | kms
SIGNER_URL=https://signer.internal
SIGNER_SECRET=
#KMS_KEY_ID=alias/aerox-rotation
#AWS_REGION=eu-west-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Relay / AppView / Labeler
RELAY_ADMIN_PASSWORD=
RELAY_TRUSTED_DOMAINS=example.com
APPVIEW_SIGNING_KEY_HEX=         # openssl rand -hex 32
IMAGE_CACHE_DIR=/var/lib/aerox/image-cache
IMAGE_CACHE_MAX_BYTES=4294967296
LABELER_DID=                     # from `mix aerox.labeler.setup`
LABELER_SIGNING_KEY_HEX=
LABELER_ADMIN_PASSWORD=
