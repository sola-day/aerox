# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
aerox-*.tar


# --- aerox ------------------------------------------------------------------

# Local environment overrides (copy .envrc.example to .envrc and edit).
# Secrets belong in /etc/aerox/<env>.env, never in the repo (DEV_PLAN §1.3).
/.envrc
.env
*.env
!.envrc.example

# Dialyzer PLTs (cached between CI runs, never committed).
/priv/plts/
*.plt
*.plt.hash

# Local data that must never be committed:
#   - account bundles carry password hashes and private signing keys (DESIGN §13.0)
#   - blob store bytes and CAR exports are user data, sometimes many GB
#   - reference-PDS snapshots used in migration drills (DEV_PLAN §1.3)
/data/
/bundles/
/snapshots/
*.car
*.tar.age
!test/golden/**/*.car

# Local blob store (Aerox.Blob.Disk root when pointed inside the repo).
/blobs/

# Golden generator scratch output; committed goldens live in test/golden/
# and are tracked with their MANIFEST.json entries (VERIFICATION §2.2).
/tools/golden/out/

# Benchmark scratch; bench/RESULTS.md is committed (VERIFICATION §10.1).
/bench/tmp/

# Node harness for @atproto/api integration tests (VERIFICATION §6).
node_modules/
/test/harness/node_modules/

# Editor / OS noise.
.DS_Store
*.swp
.elixir_ls/
.lexical/
/.vscode/
/.idea/
