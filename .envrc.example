# Host-side connection settings for the dockerised Postgres (compose.yaml).
# Port 5433 to stay clear of any host/other-container Postgres on 5432.
export PGHOST=127.0.0.1
export PGPORT=5433
export PGUSER=aerox
export PGPASSWORD=aerox
export DATABASE_HOST=127.0.0.1
export DATABASE_PORT=5433
# The four service roles default to password = role name in dev/test; set
# DATABASE_ROLE_PASSWORD to override all four (DESIGN §4.6).

# Dev server behind the local Traefik (DEV_PLAN §1.2). AEROX_BIND_IP is the
# address Phoenix listens on: the `multica` bridge gateway, which the Traefik
# container can reach and the public interface cannot. PHX_HOST is the name
# Traefik holds a certificate for and the service endpoint atproto clients
# will read back. Unset both to fall back to 127.0.0.1 / localhost.
export AEROX_BIND_IP=172.18.0.1
export PHX_HOST=aerox.sola.town
